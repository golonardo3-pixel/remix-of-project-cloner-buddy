{
  "manifest_version": 3,
  "name": "Lovable Helper Pro",
  "version": "1.1.0",
  "description": "Copie prompts prontos para usar no Lovable. Templates, histórico e produtividade.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
