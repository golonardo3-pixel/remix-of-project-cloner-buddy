{
  "manifest_version": 3,
  "name": "Lovable Helper Pro",
  "version": "1.0.0",
  "description": "Automatize prompts no Lovable com templates prontos, histórico e envio rápido.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.lovable.dev/*", "*://*.lovable.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}